# 어디버려 환경변수 예시 (.env.example)
# 실제 값은 .env.local 에 넣는다 (.env* 는 git 에서 무시됨).

# Supabase 프로젝트 URL (예: https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon(public) 키 — 브라우저 노출 전제, RLS 로 보호한다
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 시드/관리 전용 키 (RLS 우회) — 03단계 seed 스크립트에서 사용.
# 🔒 절대 NEXT_PUBLIC_ 접두어 금지, 브라우저/커밋 노출 금지.
SUPABASE_SERVICE_ROLE_KEY=

# --- SEO (선택) ---
# 사이트 절대 URL. 커스텀 도메인 붙이면 여기에 지정(canonical/OG/sitemap 기준).
NEXT_PUBLIC_SITE_URL=
# 검색엔진 사이트 소유확인 코드(있을 때만 meta 출력).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=

